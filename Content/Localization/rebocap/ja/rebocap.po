#: [RebocapA2TAnimGraphNode]RebocapA2TNodeTitle
msgid "Rebocap A-Pose to T-Pose"
msgstr "Rebocap A-PoseからT-Poseへ変換 (A2T)"

#: [RebocapA2TAnimGraphNode]RebocapA2TNodeTooltip
msgid "Calibrates A-Pose characters into standard T-Pose for Rebocap motion capture."
msgstr "Rebocap用の補正ノード。A-Poseキャラクターの四肢をT-Poseに補正します。"

#: [RebocapA2TAnimGraphNode]RebocapA2TCategory
msgid "Rebocap"
msgstr "Rebocap"

#: [RebocapA2TAnimGraphNode]RebocapA2TKeywords
msgid "rebocap, a2t, tpose, a-pose, t-pose, calibrate, limb, mocap, live link"
msgstr "rebocap, a2t, tpose, a-pose, t-pose, calibrate, キャリブレーション, モーキャプ, ポーズ"

#: [RebocapAnimGraphNode]RebocapPoseNodeTitle
msgid "Rebocap Body Pose"
msgstr "Rebocap ボディポーズ (Body Pose)"

#: [RebocapAnimGraphNode]RebocapPoseNodeTooltip
msgid "Drives skeletal mesh with real-time Rebocap LiveLink motion capture data via bone retarget mapping."
msgstr "Rebocapのリアルタイムモーションキャプチャを受信し、ボーンリマップ経由でキャラクターを駆動します。"

#: [RebocapAnimGraphNode]RebocapPoseCategory
msgid "Rebocap"
msgstr "Rebocap"

#: [RebocapAnimGraphNode]RebocapPoseKeywords
msgid "rebocap, mocap, live link, pose, skeleton, motion capture"
msgstr "rebocap, mocap, live link, モーキャプ, ポーズ, スケルトン"

#: [RebocapSourceEditor]Port
msgid "Port"
msgstr "ポート"

#: [RebocapSourceEditor]Connect
msgid "Connect"
msgstr "接続"

#: [RebocapSourceFactory]SourceDisplayName
msgid "Rebocap Source"
msgstr "Rebocap ソース"

#: [RebocapSourceFactory]SourceTooltip
msgid "Creates a connection to a Rebocap Source"
msgstr "Rebocap ソースへの接続を作成します"

#: [RebocapMapDataDetails]PresetCategoryName
msgid "0. Presets & Actions"
msgstr "0. プリセットと操作 (Presets & Actions)"

#: [RebocapMapDataDetails]ExportJsonButton
msgid "📤 Export to JSON"
msgstr "📤 JSONへエクスポート"

#: [RebocapMapDataDetails]ExportJsonTooltip
msgid "Export current 24 bone names and foot vertices to JSON (fully compatible with Blender plugin format). / 导出当前骨骼配置为 JSON 文件。"
msgstr "現在の24本のボーン名と足底頂点をJSONファイルにエクスポートします（Blenderプラグイン形式と完全互換）。"

#: [RebocapMapDataDetails]ImportJsonButton
msgid "📥 Import from JSON"
msgstr "📥 JSONからインポート"

#: [RebocapMapDataDetails]ImportJsonTooltip
msgid "Select and import JSON configuration to auto-fill bone names and foot vertices (fully compatible with Blender plugin format). / 从 JSON 文件导入骨骼配置。"
msgstr "JSON設定ファイルを選択してインポートし、ボーン名と足底頂点を自動入力します（Blenderプラグイン形式と完全互換）。"
